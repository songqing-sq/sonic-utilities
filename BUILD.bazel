[
    write_file(
        name = "entrypoint_" + name.replace("-", "__"),
        out = "entrypoints/" + name,
        content = [
            "#!/usr/bin/python3",
            "# -*- coding: utf-8 -*-",
            "import re",
            "import sys",
            "from {} import {}".format(target.split(":")[0], target.split(":")[1]),
            "if __name__ == '__main__':",
            "    sys.argv[0] = re.sub(r'(-script\\.pyw|\\.exe)?$', '', sys.argv[0])",
            "    sys.exit({}())".format(target.split(":")[1]),
            # write_file joins with newline but adds no trailing one; pip's
            # wrappers end with a newline, so add an empty final element.
            "",
        ],
        newline = "unix",
    )
    for name, target in _CONSOLE_SCRIPTS.items()
]

tar(
    name = "entrypoints_bin",
    srcs = [
        ":entrypoint_" + n.replace("-", "__")
        for n in _CONSOLE_SCRIPTS
    ],
    mutate = mutate(
        package_dir = "/usr/local/bin",
        strip_prefix = "entrypoints",
    ),
)

# setuptools' `scripts=` install step rewrites ANY python shebang -- bare
# `python`, `python3`, with or without `env`, with or without a space after
# `#!` -- to the absolute interpreter it is building for (#!/usr/bin/python3).
# Non-python scripts (#!/bin/bash etc.) are left alone. Reproduce that so the
# installed scripts match Make's byte for byte.
genrule(
    name = "scripts_shebang",
    srcs = _SCRIPTS + ["ssd-dump/vtFA_RTK_5766_v2"],
    outs = ["scripts_fixed.tar"],
    cmd = ("set -euo pipefail; W=$$(mktemp -d); trap 'rm -rf $$W' EXIT; " +
           "for f in $(SRCS); do " +
           "  sed -E '1s@^#!\\s*/usr/bin/(env +)?python[0-9.]*\\s*$$@#!/usr/bin/python3@' " +
           "    \"$$f\" > $$W/$$(basename $$f); " +
           "  chmod 755 $$W/$$(basename $$f); " +
           "done; " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner --sort=name -C $$W ."),
)

alias(
    name = "scripts_bin",
    actual = ":scripts_shebang",
)

genrule(
    name = "install",
    srcs = [":python_files", ":scripts_bin", ":entrypoints_bin"],
    outs = ["install.tar.gz"],
    # NOT `cat a.tar.gz b.tar.gz`: that produces two concatenated gzip members
    # whose tar payloads each end in an end-of-archive marker, so every reader
    # stops after the first one (the /usr/local/bin half was silently dropped).
    # Unpack both into one dir and repack as a single stream instead.
    cmd = ("set -euo pipefail; W=$$(mktemp -d); " +
           "trap 'rm -rf $$W' EXIT; " +
           "mkdir -p $$W/usr/local/bin; " +
           "tar -xzf $(location :python_files) -C $$W; " +
           "tar -xf $(location :scripts_bin) -C $$W/usr/local/bin; " +
           "tar -xzf $(location :entrypoints_bin) -C $$W; " +
           "tar -czf $@ --owner=0 --group=0 --numeric-owner --sort=name -C $$W ."),
    visibility = ["//visibility:public"],
)

# =============================================================================
# sonic-utilities-data — bash completions for the CLI entry points plus the
# runtime j2 templates.
#
# The legacy build runs sonic-utilities-data/generate_completions.py, which
# imports every entry point so click can source() its completion. That needs
# the whole CLI importable at build time, while the emitted text is just
# click's fixed bash template with the program name substituted — so emit it
# directly (gen_completion.py, verified byte-identical against the Make deb
# for plain, hyphenated and underscored names alike).
# =============================================================================
