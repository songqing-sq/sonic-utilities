# Install tar layer (OCI image consumer). Layout matches
# `pip3 install sonic_utilities-*.whl` on Debian system Python:
#   packages   -> /usr/lib/python3/dist-packages/<pkg>/...
#   scripts    -> /usr/local/bin/<script>
#   data_files -> /usr/local/bin/<file> (from setup.py `("bin", [...])`)
# entry_points console shims are generated by pip at install time; here we
# skip generating them to keep BUILD.bazel manageable — Make's dh_python3
# adds them, so consuming dockers that need e.g. `config`/`show` at
# /usr/local/bin/ should include the wheel entry_points or reinstall.
tar(
    name = "python_files",
    srcs = glob(_PACKAGE_GLOBS) + _PACKAGE_DATA,
    mutate = mutate(
        package_dir = "/usr/lib/python3/dist-packages",
        strip_prefix = package_name(),
    ),
)

# setup.py's entry_points['console_scripts']. `pip install` generates one
# wrapper per entry under /usr/local/bin; this package vendors
# `fastentrypoints`, which replaces setuptools' slow pkg_resources-based
# template with the direct-import form below (verified byte-identical to the
# wrappers in Make's image). Without these, `config`, `show`, `sfputil`,
# `sonic-installer` and 28 more core CLI commands simply do not exist.
