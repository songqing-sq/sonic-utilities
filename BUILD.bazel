# =============================================================================
# Unit tests. Bazel equivalent of the Make-side SONIC_PYTHON_WHEELS test step
# (pip install ".[testing]" + python3 -m pytest). One sonic_py_pytest_test per
# tests/**/*.py file whose name looks like a suite.
#
# The suites use their OWN tests/mock_tables (a pure-Python ConfigDB stand-in;
# conftest.py does `from .mock_tables import dbconnector`) and mockredispy, so
# no live redis. First-party deps: the module's own packages (:sources) +
# swsscommon pybind + sonic_py_common. Third-party from the uv hub.
# =============================================================================
# netifaces from apt; see MODULE.bazel for why not pip.
apt_tree(
    name = "apt_py",
    strip = "usr/lib/python3/dist-packages",
    tars = ["@sonic_utilities_apt//python3-netifaces:data"],
)

py_library(
    name = "pytest_lib",
    testonly = True,
    srcs = glob(["tests/**/*.py"]),
    data = glob(["tests/**"], exclude = ["tests/**/*.py"]) + [
        ":apt_py",
        # config/*.py load_module_from_source() this by its installed absolute
        # path; SONIC_BIN_DIR (below) redirects them to the staged copy.
        "@sonic-config-engine//:sonic-cfggen",
        # swsssdk resolves its default database_config.json relative to its own
        # package dir; :sources carries only .py, so ship the JSON too.
        "@sonic-py-swsssdk//:package_data",
    ],
    imports = ["."],
    deps = [
