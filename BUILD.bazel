[sonic_py_pytest_test(
    name = "ut_" + f[len("tests/"):-len(".py")].replace("/", "_").replace("-", "_"),
    test_file = f,
    # CWD is the runfiles _main dir, so ../ escapes to the runfiles root.
    env = {
        # netifaces (apt) + libyang's python binding, for any subprocess that
        # starts fresh and does not inherit the shim-rebuilt sys.path.
        "PYTHONPATH": ":".join([
            "../sonic-utilities+/apt_py",
            "../libyang3-py3+",
            # Suites import their fixture packages unqualified (e.g.
            # `from wm_input.wm_test_vectors import testData`), which needs the
            # tests dir itself on sys.path -- tests/ is a package, so pytest's
            # prepend import mode only adds the module root.
            "../sonic-utilities+/tests",
        ]),
        # libyang.so.3 + its pcre2/xxhash closure, same dirs sonic-yang-mgmt
        # enumerates (never a trixie glibc -- py_test runs under the host
        # interpreter).
        "LD_LIBRARY_PATH": ":".join([
            "../libyang3++_repo_rules+libyang3_src",
            "../libyang3-py3+/runtime_libs",
        ]),
        # Where the staged sonic-cfggen lives, for the absolute-path loads in
        # config/*.py (see utilities_common.general.load_module_from_source).
        "SONIC_BIN_DIR": "../sonic-config-engine+",
        # tests/conftest.py keeps its scratch tree (and its private copy of
        # mock_tables) in /tmp/worker-$PYTEST_XDIST_WORKER, defaulting to
        # "master", and rmtree()s it on entry. Make runs one pytest with
        # `-n auto`, so xdist hands each worker a distinct id; here every suite
        # is its own process with the variable unset, so they would all claim
        # -- and wipe -- the same directory (/tmp is not sandboxed: this host
        # has no unprivileged userns). Reuse the hook the tests already provide
        # and give each target its own id.
        "PYTEST_XDIST_WORKER": f[len("tests/"):-len(".py")].replace("/", "_").replace("-", "_"),
    },
    venv = "sonic-utilities",
    deps = [":pytest_lib"],
) for f in glob(
    ["tests/**/*_test.py", "tests/**/test_*.py"],
    exclude = _EXCLUDED_TESTS,
)]
