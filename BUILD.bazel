    "watchdogutil",
]

# Target names are indexed rather than derived from the program name: the entry
# points include both `sonic-installer` and `sonic_installer`, which would
# normalise to the same label.
py_binary(
    name = "gen_completion",
    srcs = ["sonic-utilities-data/gen_completion.py"],
    main = "sonic-utilities-data/gen_completion.py",
)

[
    genrule(
        name = "completion_%d" % i,
        outs = ["completions/" + c],
        cmd = "$(execpath :gen_completion) " + c + " $@",
        tools = [":gen_completion"],
    )
    for i, c in enumerate(_UTIL_COMPLETIONS)
]

sonic_deb(
    name = "sonic-utilities-data_1.0-1_all.deb",
    architecture = "all",
    content = {
        "/etc/bash_completion.d:*:0644": [
