module(
    name = "sonic-utilities",
    version = "1.2",
)

# The wheel itself is pure Python (no cc, no apt, no patches);
# sonic-utilities-data packages the CLI completions + j2 templates via sonic_deb.
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "tar.bzl", version = "0.8.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")

# Test-only first-party deps: suites import swsscommon (pybind), sonic_py_common,
# and sonic-config-engine's tests/mock_tables ConfigDB stand-in.
bazel_dep(name = "sonic-swss-common", version = "1.0.0")
bazel_dep(name = "sonic-py-common", version = "1.0")
bazel_dep(name = "sonic-py-swsssdk", version = "2.0.1")
bazel_dep(name = "sonic-platform-common", version = "1.0")
# config/main.py and the GCU suites import sonic_yang (libyang3-backed).
bazel_dep(name = "sonic-yang-mgmt", version = "1.0")
bazel_dep(name = "libyang3-py3", version = "3.12.2")
bazel_dep(name = "sonic-config-engine", version = "1.0")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(hub_name = "sonic_utilities_pip")
uv.project(
    hub_name = "sonic_utilities_pip",
    pyproject = "//bazel:pyproject.toml",
    lock = "//bazel:uv.lock",
)
uv.override_package(
    lock = "//bazel:uv.lock",
    name = "mockredispy",
    pre_build_patches = ["//bazel:mockredispy-drop-nose.patch"],
    pre_build_patch_strip = 1,
)
use_repo(uv, "sonic_utilities_pip")

# netifaces (imported by config/main.py and utilities_common/multi_asic.py) is a
# C extension PyPI ships sdist-only; aspect's sdist_build cannot compile it here
# (non-hermetic host compiler), so take the distro build. Never the glibc family
# -- a py_test runs under the host interpreter.
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "sonic_utilities_apt",
    packages = ["python3-netifaces:amd64"],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "sonic_utilities_apt")
